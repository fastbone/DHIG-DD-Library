# Copy to .env before `docker compose up`. Keep .env out of version control.

# ── Required ────────────────────────────────────────────────────────────────
# Encrypts stored Anthropic API keys. Generate once and keep it:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Losing or changing it makes every stored API key undecryptable (re-add them).
DD_SECRET_KEY=

# ── First administrator ─────────────────────────────────────────────────────
# Created on first start if no accounts exist. You can instead leave these
# blank and create the first admin in the browser on first visit.
DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=
# Set to 1 for one restart to reset a locked-out administrator's password.
DD_ADMIN_RESET_PASSWORD=0

# ── Anthropic credentials ───────────────────────────────────────────────────
# Optional: keys added through Admin → API keys take precedence over this.
ANTHROPIC_API_KEY=

# ── Models ──────────────────────────────────────────────────────────────────
DD_ANALYST_MODEL=claude-opus-5
DD_CARDER_MODEL=claude-haiku-4-5
DD_VERIFIER_MODEL=claude-haiku-4-5
DD_ANALYST_EFFORT=high

# ── Behaviour ───────────────────────────────────────────────────────────────
# OCR pages with no text layer. Needs an image built with INSTALL_OCR=true.
DD_OCR=0
# Lets the analyst compute over original spreadsheets. It executes
# model-authored code — keep the container hardening in docker-compose.yml.
DD_ENABLE_PYTHON=1
DD_EXTRACT_WORKERS=3
DD_CARD_CONCURRENCY=8

# ── Sessions ────────────────────────────────────────────────────────────────
DD_SESSION_TTL_HOURS=12
# Set to 1 when serving over HTTPS so the session cookie is Secure.
DD_COOKIE_SECURE=0
DD_LOGIN_MAX_ATTEMPTS=8
DD_LOGIN_LOCKOUT_SECONDS=300

# ── Upload limits ───────────────────────────────────────────────────────────
DD_MAX_UPLOAD_MB=4096
DD_MAX_EXTRACT_GB=20
DD_MAX_ARCHIVE_MEMBERS=100000
DD_MAX_COMPRESSION_RATIO=200

# ── Behind a reverse proxy ──────────────────────────────────────────────────
# Trust X-Forwarded-* from this proxy address only.
DD_FORWARDED_ALLOW_IPS=127.0.0.1
